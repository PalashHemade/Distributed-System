# Gateway Server Configuration
GATEWAY_PORT=5000

# MongoDB Configuration (REQUIRED — the app will not boot without this)
MONGODB_URI=

# Auth — used to sign/verify classroom login JWTs. Any long random string for local dev.
JWT_SECRET=

# React Client Configuration
VITE_GATEWAY_URL=http://localhost:5000

# --- Multi-host deployment only (e.g. AWS) — leave all of these unset for local dev ---
# GATEWAY_URL: the full URL a node uses to reach the Gateway. Only needed when
# the Gateway runs on a different machine than this node. Defaults to
# http://localhost:${GATEWAY_PORT}.
# GATEWAY_URL=http://<gateway-private-ip>:5000
#
# NODE_HOST: what this node tells the Gateway and its peers to reach IT at.
# Defaults to "localhost", which is correct ONLY when every process shares
# one machine. On separate hosts this MUST be this instance's real address
# (its private IP on AWS).
# NODE_HOST=<this-instance-private-ip>
#
# PEER_NODES: optional static seed list for the gossip fallback, so a node
# can still find peers without waiting on the Gateway. Comma-separated
# nodeId@host:port entries.
# PEER_NODES=node-A@10.0.1.5:5001,node-B@10.0.1.6:5002,node-C@10.0.1.7:5003
