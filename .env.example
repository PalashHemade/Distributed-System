# Gateway Server Configuration
GATEWAY_PORT=5000

# MongoDB Configuration (REQUIRED — the app will not boot without this)
MONGODB_URI=

# Auth — used to sign/verify classroom login JWTs. Any long random string for local dev.
JWT_SECRET=

# AWS S3 — resource uploads/downloads are stored here instead of local disk.
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# React Client Configuration
VITE_GATEWAY_URL=http://localhost:5000
